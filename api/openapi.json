{
  "components": {
    "schemas": {
      "BookOut": {
        "description": "A book as the library list shows it.",
        "properties": {
          "author": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Author"
          },
          "cover_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cover Url"
          },
          "failure": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Failure"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/BookStatus"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "author",
          "status",
          "cover_url",
          "failure"
        ],
        "title": "BookOut",
        "type": "object"
      },
      "BookStatus": {
        "description": "Where a book is on its way to the library.",
        "enum": [
          "processing",
          "ready",
          "failed"
        ],
        "title": "BookStatus",
        "type": "string"
      },
      "DuplicateOut": {
        "description": "The reject of a file the reader already owns, with a link to that book.",
        "properties": {
          "book_id": {
            "format": "uuid",
            "title": "Book Id",
            "type": "string"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "code",
          "book_id",
          "title"
        ],
        "title": "DuplicateOut",
        "type": "object"
      },
      "ErrorOut": {
        "description": "A refused request. `code` names the reason.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "ErrorOut",
        "type": "object"
      },
      "Failure": {
        "description": "Why a conversion fails (`ConversionFailed`).\n\n`stuck` comes from the deadline (P2), never from a converter.",
        "enum": [
          "malformed",
          "unreadable",
          "timed_out",
          "crashed",
          "stuck"
        ],
        "title": "Failure",
        "type": "string"
      },
      "ReaderOut": {
        "description": "A reader as the pages see it.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "ReaderOut",
        "type": "object"
      },
      "SignInIn": {
        "description": "A sign-in request.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "SignInIn",
        "type": "object"
      },
      "SignUpIn": {
        "description": "A sign-up request.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 12,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "SignUpIn",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ebookdrop",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/accounts": {
      "post": {
        "operationId": "sign_up_api_accounts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReaderOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Sign Up"
      }
    },
